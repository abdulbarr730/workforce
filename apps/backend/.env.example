# Backend environment — LOCAL DEVELOPMENT defaults.
# `pnpm setup:dev` copies this file to .env (only if .env does not exist).
# Production values live only on the VPS; never paste them here.
# Full reference: docs/environment-variables.md

NODE_ENV=development
PORT=5000

# Local Docker Mongo started by `pnpm db:dev` (docker-compose.dev.yml).
MONGO_URI=mongodb://127.0.0.1:27017/workforce_dev

# DEV ONLY secret. Production uses its own long random value.
JWT_SECRET=dev-only-jwt-secret-change-me

# Comma-separated browser origins. Empty = allow all (avoid outside dev).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ---------------------------------------------------------------------------
# Integrations. Leave empty in dev: each one becomes a no-op (or fails softly).
# ---------------------------------------------------------------------------

# CRM / Pabbly. API key goes in the X-API-KEY header.
# Empty key outside production = CRM routes accept unauthenticated calls.
CRM_API_KEY=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Google Apps Script webhook that mirrors welcome calls into a sheet.
WELCOME_CALL_SHEET_WEBHOOK_URL=
WELCOME_CALL_SHEET_WEBHOOK_SECRET=
WELCOME_CALL_SHEET_NAME=Welcome calls

# Screenshot storage. Empty = screenshot upload signing and cleanup fail (logged).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (EOD suggestions, audits, Workforce Brain). Empty = features fall back / skip.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
IDENTITY_FEDERATION_ENABLED=
IDENTITY_FEDERATION_TOKEN_FILE=
IDENTITY_FEDERATION_TOKEN=

# Chat notifications. Empty = nothing is posted.
TEAMS_BREAK_WEBHOOK_URL=
DISCORD_BREAK_WEBHOOK_URL=
DISCORD_AUTH_WEBHOOK_URL=
DISCORD_DAILY_FLOW_WEBHOOK_URL=

# Set to 1 to stop Discord login announcements (scripts set this themselves).
SKIP_LOGIN_ANNOUNCE=

# Escape hatch for the dev-server guard. Only set to true if you really must
# run `pnpm dev:api` against a non-local database. `seed:dev` ignores it.
ALLOW_REMOTE_DB=

# ── Email (Zoho ZeptoMail) ──────────────────────────────────────────────────
# Send Mail token from ZeptoMail > Mail Agents > SMTP/API (the full value,
# including "Zoho-enczapikey "). Without it no email is sent (logged only).
ZEPTOMAIL_TOKEN=
# The URL in the agent's SMTP/API tab -> sample code. Default (India):
# https://cpaas.zoho.in/v1.1/email
ZEPTOMAIL_API_URL=
# A sender on a domain verified in ZeptoMail, e.g. noreply@prosyncedu.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Prosync Workforce
# Links used in emails
EMPLOYEE_DASHBOARD_URL=https://employee.prosyncedu.com
ADMIN_DASHBOARD_URL=
# Email cost estimate for Admin Controls (USD per 1,000 emails)
EMAIL_COST_PER_1000_USD=0.25

# ── AI cost estimate (Admin Controls) ───────────────────────────────────────
# Your real prices in USD per million tokens. Empty = built-in estimates by
# model family (Haiku 1/5, Sonnet 3/15, Opus 5/25).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
